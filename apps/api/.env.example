DATABASE_URL="postgresql://epi_user:epi_pass@localhost:5432/epi_db"
PORT=3001
NODE_ENV=development
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Opcional: si se define, el webhook exige este secreto (?secret= o header x-jotform-secret)
JOTFORM_WEBHOOK_SECRET=
# Requerida para analizar preguntas abiertas con IA (hoy: Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# API key de la cuenta de Jotform — sincroniza el catálogo de formularios y
# descarga sus preguntas (Settings > API en jotform.com)
JOTFORM_API_KEY=
JOTFORM_API_BASE=https://api.jotform.com
# Etiquetas de pregunta (separadas por coma, tal como aparecen en Jotform)
# que se tratan como catálogo/filtro en vez de pregunta ponderable
CATALOG_DATA=GRUPO,GRADO,TIPO DE PROGRAMA,EDAD
